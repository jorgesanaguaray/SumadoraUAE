<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo que declara la aplicación Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nombre, tema e ícono de la aplicación. -->
    <application android:allowBackup="true" android:icon="@drawable/ic_android_black_24dp" android:label="@string/app_name" android:roundIcon="@drawable/ic_android_black_24dp" android:supportsRtl="true" android:theme="@style/Theme.SumadoraUAE">
        <!-- Actividad principal que se puede abrir desde el lanzador. -->
        <activity android:name=".MainActivity" android:exported="true">
            <!-- Filtro que marca la pantalla inicial de la aplicación. -->
            <intent-filter>
                <!-- Acción principal de inicio. -->
                <action android:name="android.intent.action.MAIN" />
                <!-- Categoría del ícono en la pantalla de aplicaciones. -->
                <category android:name="android.intent.category.LAUNCHER" />
            <!-- Fin del filtro de inicio. -->
            </intent-filter>
        <!-- Fin de la actividad principal. -->
        </activity>
    <!-- Fin de la aplicación. -->
    </application>
<!-- Fin del manifiesto. -->
</manifest>
